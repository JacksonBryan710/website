# Copy this file to .env.local (already gitignored) and fill in your own values.

# Supabase project URL and publishable (public) key. Find both under
# Project Settings > API in the Supabase dashboard. The publishable key is
# safe to expose client-side — it's only as powerful as the Row Level
# Security policies on each table allow.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
